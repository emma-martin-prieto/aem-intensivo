<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" 
          xmlns:cq="http://www.day.com/jcr/cq/1.0" 
          xmlns:jcr="http://www.jcp.org/jcr/1.0" 
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          jcr:primaryType="nt:unstructured"
          jcr:title="Configuración Footer"
          sling:resourceType="cq/gui/components/authoring/dialog">

    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">

        <items jcr:primaryType="nt:unstructured">

            <logoPath
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                fieldLabel="Ruta del Logotipo"
                name="./logoPath"
                rootPath="/content/dam"/>

            <legalText
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                fieldLabel="Texto del párrafo"
                fieldDescription="Texto descriptivo o aviso legal que aparece bajo el título BuyCar"
                name="./legalText"
                emptyText="Texto legal de BuyCar"/>

            <address
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Ubicación"
                fieldDescription="Dirección física de la empresa"
                name="./address"
                emptyText="Dirección de BuyCar"/>

            <email
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Email de contacto"
                fieldDescription="Se usará tanto como texto visible como en el href mailto:"
                name="./email"
                emptyText="info@buycar.com"/>

            <copyrightText
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Texto copyright"
                fieldDescription="Ej: © 2024 BuyCar. Todos los derechos reservados."
                name="./copyrightText"
                emptyText="© 2023 PT Beli Mobil Duit Sendiri"/>

            <socialLinks
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                fieldLabel="Redes Sociales"
                composite="{Boolean}true">

                <field
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/container"
                    name="./socialLinks">

                    <items jcr:primaryType="nt:unstructured">

                        <icon
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                            fieldLabel="Icono (DAM)"
                            name="./iconPath"
                            rootPath="/content/dam"/>

                        <url
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Enlace"
                            name="./link"/>

                    </items>
                </field>
            </socialLinks>
        </items>
    </content>
</jcr:root>