<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="BMW Models Header"
    sling:resourceType="cq/gui/components/authoring/dialog">

    <content jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            
            <tag jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Tag" name="./tag" />

            <title jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Título" name="./title" />

            <intro jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                fieldLabel="Intro" name="./intro" />

            <!-- Nuevo: Selector de estilo/color -->
            <style jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                fieldLabel="Estilo del Header"
                name="./style">
                <items jcr:primaryType="nt:unstructured">
                    <option1 jcr:primaryType="nt:unstructured"
                        value="default" text="BMW Classic Blue"/>
                    <option2 jcr:primaryType="nt:unstructured"
                        value="dark" text="Dark Premium"/>
                    <option3 jcr:primaryType="nt:unstructured"
                        value="black" text="Black and Gold"/>
                    <option4 jcr:primaryType="nt:unstructured"
                        value="m-performance" text="M Performance"/>
                    <option5 jcr:primaryType="nt:unstructured"
                        value="audi" text="Audi Red"/>
                </items>
            </style>

        </items>
    </content>
</jcr:root>