<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Configuración Contact Section"
    sling:resourceType="cq/gui/components/authoring/dialog">

    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">

        <items jcr:primaryType="nt:unstructured">

            <tagText
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Texto etiqueta superior"
                name="./tagText"
                emptyText="Contacto BuyCar"/>

            <heading
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Título principal"
                name="./heading"
                emptyText="Estamos aquí para ayudarte"/>

            <lead
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                fieldLabel="Texto introductorio"
                name="./lead"
                emptyText="¿Tienes dudas sobre un modelo, una prueba de conducción o cualquier consulta? Ponte en contacto con nosotros y te responderemos lo antes posible."/>

            <mapCardTitle
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Título bloque mapa"
                name="./mapCardTitle"
                emptyText="Dónde encontrarnos"/>

            <mapCardSubtitle
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Subtítulo bloque mapa"
                name="./mapCardSubtitle"
                emptyText="Visítanos o localiza nuestras sedes"/>

            <formTitle
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Título del formulario"
                name="./formTitle"
                emptyText="Contáctanos"/>

            <formSubtitle
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Subtítulo del formulario"
                name="./formSubtitle"
                emptyText="Completa el formulario y te escribiremos pronto"/>

            <submitText
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Texto botón enviar"
                name="./submitText"
                emptyText="Enviar mensaje"/>

            <successMessage
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Mensaje de éxito"
                name="./successMessage"
                emptyText="¡Gracias! Nos pondremos en contacto pronto."/>

            <mapUrl
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldDescription="Pega el iframe completo de Google Maps o su src según el uso que quieras dar"
                fieldLabel="Mapa"
                name="./mapUrl"/>

        </items>
    </content>
</jcr:root>