<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Configuración Audi Model Grid"
    sling:resourceType="cq/gui/components/authoring/dialog">

    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">

                    <cards
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                        composite="{Boolean}true"
                        fieldLabel="Listado de Modelos Audi">
                        <field
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            name="./cards">
                            <items jcr:primaryType="nt:unstructured">

                                <!-- Imagen -->
                                <image
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                    fieldLabel="Imagen del coche (PNG transparente recomendado)"
                                    name="imagePath"
                                    rootPath="/content/dam"/>

                                <!-- Identificación del modelo -->
                                <tag
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Línea / Etiqueta (ej: S line, RS, e-tron GT)"
                                    name="tag"/>

                                <title
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Nombre del modelo (ej: Audi A6)"
                                    name="modelTitle"/>

                                <!-- Datos técnicos -->
                                <power
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Potencia (ej: 204 CV)"
                                    name="powerText"/>

                                <range
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Autonomía (ej: 540 km) — dejar vacío si no aplica"
                                    name="rangeText"/>

                                <accel
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Aceleración 0-100 km/h (ej: 7.3 s)"
                                    name="accelText"/>

                                <!-- Precio -->
                                <price
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Precio (ej: 42.900 €)"
                                    name="priceMain"/>

                                <!-- Badge quattro -->
                                <quattro
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                    fieldLabel="Tracción quattro®"
                                    name="quattro"
                                    text="Mostrar badge quattro en la tarjeta"/>

                                <!-- CTAs -->
                                <btn1Text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Texto botón primario"
                                    name="btn1Text"
                                    emptyText="Configurar"/>

                                <btn1Link
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="URL botón primario"
                                    name="btn1Link"
                                    emptyText="#"/>

                                <btn2Text
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Texto botón secundario"
                                    name="btn2Text"
                                    emptyText="Más info"/>

                                <btn2Link
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="URL botón secundario"
                                    name="btn2Link"
                                    emptyText="#"/>

                            </items>
                        </field>
                    </cards>

                </items>
            </column>
        </items>
    </content>
</jcr:root>