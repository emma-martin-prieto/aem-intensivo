<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="About Hero"
    sling:resourceType="cq/gui/components/authoring/dialog">

    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">

        <items jcr:primaryType="nt:unstructured">

            <tag
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Etiqueta"
                name="./tag"
                emptyText="Sobre BuyCar"/>

            <title
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                required="{Boolean}true"
                fieldLabel="Título"
                name="./title"
                emptyText="Pasión por la automoción, confianza en cada decisión"/>

            <description
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                fieldLabel="Descripción"
                name="./description"
                emptyText="Texto introductorio"/>

            <imagePath
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                required="{Boolean}true"
                fieldLabel="Imagen"
                name="./imagePath"
                rootPath="/content/dam"
                nodeTypes="[dam:Asset]"/>

            <imageAlt
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Alt de la imagen"
                name="./imageAlt"
                emptyText="Equipo BuyCar"/>

            <statOneNumber
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Número estadística 1"
                name="./statOneNumber"
                emptyText="+10"/>

            <statOneLabel
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Texto estadística 1"
                name="./statOneLabel"
                emptyText="marcas disponibles"/>

            <statTwoNumber
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Número estadística 2"
                name="./statTwoNumber"
                emptyText="1"/>

            <statTwoLabel
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Texto estadística 2"
                name="./statTwoLabel"
                emptyText="equipo a tu lado"/>

            <floatingTitle
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Título tarjeta flotante"
                name="./floatingTitle"
                emptyText="Experiencia multimarca"/>

            <floatingText
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                fieldLabel="Texto tarjeta flotante"
                name="./floatingText"
                emptyText="Una forma más cómoda y visual de encontrar tu próximo coche."/>

        </items>
    </content>
</jcr:root>